# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://worker:worker@localhost:5432/worker_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your-access-secret-at-least-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=12

# Email (use Mailtrap in dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
EMAIL_FROM=noreply@worker.app

# Frontend/public app origins. Use comma-separated URLs. Wildcard is development-only.
CLIENT_URL=http://localhost:8081

# Worker Pro subscriptions via RevenueCat
# Keep disabled until the store products, RevenueCat project, and webhook are configured.
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Optional but recommended: enable HMAC signing in RevenueCat and set its signing secret here.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=worker_pro
SUBSCRIPTIONS_ENABLED=false
WORKER_FREE_ACCEPTED_REQUEST_LIMIT=5
MAX_OFFERS_PER_REQUEST=5

# Cloudinary — image uploads for request photos and avatars
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum SubscriptionProvider {
  REVENUECAT
}

enum SubscriptionPlatform {
  ANDROID
  IOS
  UNKNOWN
}

enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  GRACE_PERIOD
  BILLING_ISSUE
  CANCELLED
  EXPIRED
  REFUNDED
  UNKNOWN
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker           Worker?
  customerRequests ServiceRequest[]   @relation("CustomerRequests")
  sentMessages     Message[]          @relation("SentMessages")
  notifications    Notification[]
  favorites        Favorite[]
  reviewsGiven     Review[]           @relation("ReviewsGiven")
  reviewsReceived  Review[]           @relation("ReviewsReceived")
  subscriptions    UserSubscription[]

  @@map("users")
}

// ─── Workers ──────────────────────────────────────────────────────────────────

model Worker {
  id            String    @id @default(uuid())
  userId        String    @unique
  bio           String?
  yearsExp      Int       @default(0)
  hourlyRate    Decimal?  @db.Decimal(10, 2)
  fixedPrice    Decimal?  @db.Decimal(10, 2)
  isAvailable   Boolean   @default(true)
  ratingAvg     Float     @default(0)
  totalReviews  Int       @default(0)
  totalJobs     Int       @default(0)
  workingRadius Int       @default(20)
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories       WorkerCategory[]
  requests         ServiceRequest[]        @relation("WorkerRequests")
  availability     WorkerAvailability[]
  favorites        Favorite[]
  acceptanceUsages WorkerAcceptanceUsage[]

  @@map("workers")
}

// ─── Service Categories ───────────────────────────────────────────────────────

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String
  icon        String?
  description String?
  isActive    Boolean @default(true)

  workers  WorkerCategory[]
  requests ServiceRequest[]

  @@map("service_categories")
}

model WorkerCategory {
  workerId   String
  categoryId String

  worker   Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
  @@map("worker_categories")
}

// ─── Service Requests ─────────────────────────────────────────────────────────

model ServiceRequest {
  id            String        @id @default(uuid())
  customerId    String
  workerId      String?
  categoryId    String
  title         String
  description   String
  status        RequestStatus @default(PENDING)
  lat           Float
  lng           Float
  address       String
  scheduledAt   DateTime?
  priceAgreed   Decimal?      @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer        User                   @relation("CustomerRequests", fields: [customerId], references: [id])
  worker          Worker?                @relation("WorkerRequests", fields: [workerId], references: [id])
  category        ServiceCategory        @relation(fields: [categoryId], references: [id])
  images          RequestImage[]
  messages        Message[]
  review          Review?
  payment         Payment?
  acceptanceUsage WorkerAcceptanceUsage?

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([createdAt])
  @@map("service_requests")
}

model RequestImage {
  id        String @id @default(uuid())
  requestId String
  imageUrl  String
  order     Int    @default(0)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_images")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  requestId  String   @unique
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer User           @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User           @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@index([revieweeId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("reviews")
}

model WorkerAcceptanceUsage {
  id        String   @id @default(uuid())
  workerId  String
  requestId String   @unique
  createdAt DateTime @default(now())

  worker  Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_acceptance_usages")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(uuid())
  requestId String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation("SentMessages", fields: [senderId], references: [id])

  @@index([requestId])
  @@map("messages")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(uuid())
  requestId           String        @unique
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("usd")
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  stripePaymentIntent String?
  createdAt           DateTime      @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@map("payments")
}

model UserSubscription {
  id                    String                  @id @default(uuid())
  userId                String
  provider              SubscriptionProvider    @default(REVENUECAT)
  entitlementId         String
  storeProductId        String?
  platform              SubscriptionPlatform    @default(UNKNOWN)
  environment           SubscriptionEnvironment @default(SANDBOX)
  status                SubscriptionStatus      @default(UNKNOWN)
  originalTransactionId String?
  appUserId             String?
  purchaseDate          DateTime?
  originalPurchaseDate  DateTime?
  expirationDate        DateTime?
  willRenew             Boolean?
  cancellationDate      DateTime?
  billingIssueDate      DateTime?
  lastEventId           String?
  lastEventType         String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, originalTransactionId])
  @@index([userId, provider, entitlementId])
  @@index([appUserId])
  @@index([status])
  @@map("user_subscriptions")
}

model SubscriptionWebhookEvent {
  id              String               @id @default(uuid())
  provider        SubscriptionProvider @default(REVENUECAT)
  providerEventId String
  type            String
  processedAt     DateTime?
  createdAt       DateTime             @default(now())

  @@unique([provider, providerEventId])
  @@map("subscription_webhook_events")
}

// ─── Favorites ────────────────────────────────────────────────────────────────

model Favorite {
  id         String @id @default(uuid())
  customerId String
  workerId   String

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([customerId, workerId])
  @@map("favorites")
}

// ─── Worker Availability ──────────────────────────────────────────────────────

model WorkerAvailability {
  id        String @id @default(uuid())
  workerId  String
  dayOfWeek Int
  startTime String
  endTime   String

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_availability")
}
